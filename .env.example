# Smart City Site Planning — Environment Variables Configuration
# Developer: Ankit Yadav (AkkiCoder)
# Hacktoberfest Hack Day Kanpur × AI Club 2026

# ==========================================
# 1. Gemma 4 AI Assistant Configuration
# ==========================================
# Server-Side Gemma 4 API Key (Never expose to client or prefix with VITE_)
# When unset, the application automatically runs in transparent Heuristic Demo Mode.
GEMINI_API_KEY=""

# Gemma 4 Model Identifier (Defaults to Google's open-weights 31B instruction-tuned model)
GEMMA_MODEL="gemma-4-31b-it"

# ==========================================
# 2. Firebase Authentication & Firestore
# ==========================================
# Configure these variables from your Firebase Console (Project Settings > General > Your apps)
# When unset, the application provides an authenticated local fallback session for immediate testing.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ==========================================
# 3. External Geographic & Weather APIs
# ==========================================
# Base URL for Open-Meteo weather API (Free public API, no key required)
VITE_OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"

# Base URL for OpenStreetMap Overpass API (Free public API for contextual geographic features)
VITE_OVERPASS_BASE_URL="https://overpass-api.de/api/interpreter"

# Optional Formspree endpoint for contact form submissions (falls back to mailto: if unset)
VITE_FORMSPREE_ENDPOINT=""

# Public deployment URL
VITE_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
